:root{
  --yellow:#fac80f;
  --teal:#2a8a94;
  --green:#a1c93a;
  --navy:#2b3990;
  --paper:#fffdf5;
  --card:#fff;
  --ink:#1d2a4a;
  --muted:#55607f;
  --line:#e8e2c9;
  --soft:#e6f4f5;

  --head:"Fredoka","Trebuchet MS",sans-serif;
  --body:"Nunito","Segoe UI",system-ui,sans-serif;

  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);

  color-scheme:light;
}

@media (prefers-color-scheme:dark){

  :root:not([data-theme="light"]){

    --paper:#10192e;
    --card:#18233f;
    --ink:#f2f4fb;
    --muted:#b3bcd6;
    --line:#2c3a5e;
    --soft:#14323a;
    --teal:#4cc0cb;

    color-scheme:dark;
  }
}

:root[data-theme="dark"]{

  --paper:#10192e;
  --card:#18233f;
  --ink:#f2f4fb;
  --muted:#b3bcd6;
  --line:#2c3a5e;
  --soft:#14323a;
  --teal:#4cc0cb;

  color-scheme:dark;
}

html{
  scroll-padding-top:env(safe-area-inset-top,0px);
  scroll-behavior:smooth;
}

*,
*::before,
*::after{
  box-sizing:inherit;
}

body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font:400 18px/1.65 var(--body);
}

a{
  color:inherit;
}

:focus-visible{
  outline:3px solid var(--navy);
  outline-offset:3px;
}

.wrap{
  max-width:1000px;
  margin:0 auto;
  padding:0 20px;
}


/* =========================
   NAVIGATION
========================= */

nav{
  display:flex;
  align-items:center;
  gap:12px;
  padding:12px 0;
  flex-wrap:wrap;
}

nav strong{
  font:600 22px var(--head);
  margin-right:auto;
}

nav a{
  font-weight:800;
  text-decoration:none;
  padding:8px 14px;
  border-radius:99px;
  background:var(--yellow);
  color:#1d2a4a;
}


/* =========================
   HEADER LOGO
========================= */

.header-logo{
  width:56px;
  height:56px;

  display:block;

  object-fit:contain;

  /* IMPORTANT */
  background:transparent;

  /* No white circle */
  border:0;
}


/* =========================
   HERO
========================= */

.hero{
  background:var(--teal);
  color:#fff;
  position:relative;
  overflow:hidden;
}

.hero .wrap{
  padding-top:52px;
  padding-bottom:64px;
  position:relative;
}

.hero h1{
  font:600 clamp(34px,6vw,58px)/1.12 var(--head);
  margin:0 0 16px;
  max-width:15ch;
}

.hero p{
  font-size:20px;
  max-width:28em;
  margin:0 0 24px;
}


/* =========================
   LARGE HERO LOGO
========================= */

.hero-logo{
  position:absolute;

  right:20px;
  top:50%;

  transform:translateY(-50%);

  width:clamp(170px,24vw,240px);
  height:clamp(170px,24vw,240px);

  object-fit:contain;

  display:block;

  /* IMPORTANT */
  background:transparent;

  border:0;

  /* No white container */
  box-shadow:none;
}


/* =========================
   BUTTON
========================= */

.btn{
  display:inline-block;

  padding:13px 24px;

  border-radius:99px;

  font:800 18px var(--body);

  text-decoration:none;

  background:var(--yellow);

  color:#1d2a4a;

  border:0;

  cursor:pointer;
}


/* =========================
   SECTIONS
========================= */

section{
  padding:52px 0;
}

h2{
  font:600 clamp(28px,4vw,38px)/1.2 var(--head);
  margin:0 0 8px;
}

.sub{
  color:var(--muted);
  margin:0 0 24px;
}


/* =========================
   TABS
========================= */

.tabs{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-bottom:16px;
}

.tabs button{
  font:800 17px var(--body);

  padding:10px 18px;

  border-radius:99px;

  border:2px solid var(--teal);

  background:var(--card);

  color:var(--ink);

  cursor:pointer;
}

.tabs button[aria-selected="true"]{
  background:var(--teal);
  color:#fff;
}


/* =========================
   PANEL
========================= */

.panel{
  background:var(--soft);

  border-radius:18px;

  padding:24px;

  min-height:140px;
}

.panel h3{
  font:600 24px var(--head);
  margin:0 0 6px;
}

.panel p{
  margin:0 0 8px;
}


/* =========================
   CHIPS
========================= */

.chips{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-top:10px;
}

.chips span{
  background:var(--card);

  border:1px solid var(--line);

  padding:4px 14px;

  border-radius:99px;

  font-weight:600;

  font-size:16px;
}


/* =========================
   WHY SECTION
========================= */

.why{
  display:grid;

  grid-template-columns:
    repeat(auto-fit,minmax(210px,1fr));

  gap:16px;
}

.why div{
  background:var(--card);

  border:2px solid var(--line);

  border-radius:18px;

  padding:18px;
}

.why b{
  display:block;

  font:600 20px var(--head);

  margin-bottom:4px;
}

.why p{
  margin:0;

  color:var(--muted);

  font-size:17px;
}


/* =========================
   ENQUIRY
========================= */

.enq{
  display:grid;

  grid-template-columns:1fr 1fr;

  gap:32px;

  align-items:start;
}

form{
  display:grid;
  gap:12px;
}

label{
  font-weight:800;

  display:grid;

  gap:4px;
}

input,
select{
  font:inherit;

  padding:11px 12px;

  border:2px solid var(--line);

  border-radius:12px;

  background:var(--card);

  color:var(--ink);
}


/* =========================
   CONTACT
========================= */

.contact a{
  display:block;

  font:600 28px var(--head);

  text-decoration:none;

  margin:6px 0;
}


/* =========================
   FOOTER
========================= */

footer{
  padding:24px 0 36px;

  color:var(--muted);

  font-size:16px;

  border-top:1px solid var(--line);
}


/* =========================
   MOBILE
========================= */

@media (max-width:700px){

  .enq{
    grid-template-columns:1fr;
  }

  .hero-logo{
    position:static;

    transform:none;

    width:210px;
    height:210px;

    margin:32px auto 0;
  }

}


/* =========================
   REDUCED MOTION
========================= */

@media (prefers-reduced-motion:reduce){

  html{
    scroll-behavior:auto;
  }

}
